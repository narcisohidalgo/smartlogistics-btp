{
  "name": "smartlogistics-cap",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-ai-sdk/orchestration": "^2.16.0",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-smartlogistics-fiori": "cds watch --open smartlogistics.smartlogisticsfiori/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy smartlogistics-cap --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "test": "cds test"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "viewer": {
              "password": "viewer",
              "roles": [
                "Viewer"
              ]
            },
            "operator": {
              "password": "operator",
              "roles": [
                "Viewer",
                "Operator"
              ]
            },
            "supervisor": {
              "password": "supervisor",
              "roles": [
                "Viewer",
                "Operator",
                "Supervisor"
              ]
            }
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/smartlogistics-fiori"
  ]
}

{
  "_version": "1.89.0",
  "sap.app": {
    "id": "smartlogistics.smartlogisticsfiori",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "c846974f-5628-4924-94b4-77756c30a8f2"
    },
    "dataSources": {
      "mainService": {
        "uri": "/logistics/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "SmartLogistics-display": {
          "semanticObject": "SmartLogistics",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "smartlogistics.smartlogisticsfiori.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ShipmentsList",
          "target": "ShipmentsList"
        },
        {
          "pattern": "Shipments({key}):?query:",
          "name": "ShipmentsObjectPage",
          "target": "ShipmentsObjectPage"
        }
      ],
      "targets": {
        "ShipmentsList": {
          "type": "Component",
          "id": "ShipmentsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Shipments",
              "variantManagement": "Page",
              "navigation": {
                "Shipments": {
                  "detail": {
                    "route": "ShipmentsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "ShipmentsObjectPage": {
          "type": "Component",
          "id": "ShipmentsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Shipments",
              "controlConfiguration": {
                "incidents/@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "AnalyzeIncident": {
                      "press": "smartlogistics.smartlogisticsfiori.ext.CustomActions.analyzeIncident",
                      "enabled": "smartlogistics.smartlogisticsfiori.ext.CustomActions.enabledForSingleSelection",
                      "text": "Analyze Incident"
                    }
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "AIAssistant": {
                      "press": "smartlogistics.smartlogisticsfiori.ext.AssistantActions.openAssistant",
                      "visible": true,
                      "enabled": true,
                      "text": "AI Assistant"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "smartlogistics.smartlogisticsfiori"
  }
}

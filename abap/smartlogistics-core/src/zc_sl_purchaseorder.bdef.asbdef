projection;
strict ( 2 );

use draft;

define behavior for ZC_SL_PURCHASEORDER alias PurchaseOrder
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action sendToLogistics;

  use association _Items { create; with draft; }
}

define behavior for ZC_SL_PURCHASEORDERITEM alias PurchaseOrderItem
{
  use update;
  use delete;

  use association _PurchaseOrder { with draft; }
}